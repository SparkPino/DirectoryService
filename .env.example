# =============================================================
#  Шаблон переменных окружения для docker-compose.yml
#
#  Как использовать:
#    cp .env.example .env      (Windows PowerShell: Copy-Item .env.example .env)
#    заполнить значения в .env → docker compose up -d --build
#
#  .env находится в .gitignore и НИКОГДА не коммитится.
#  Этот файл коммитится: здесь только ключи и безопасные значения для локальной разработки.
# =============================================================

# --- Сборка бэкенда ------------------------------------------
# GitHub Personal Access Token со scope `read:packages`:
# нужен, чтобы dotnet restore скачал приватные пакеты SparkPino.* из GitHub Packages.
# Создать: GitHub → Settings → Developer settings → Personal access tokens.
GITHUB_TOKEN=

# --- PostgreSQL ----------------------------------------------
# Используются postgres (создание БД), backend и migrator (строка подключения).
# Значения ниже подходят только для локальной разработки; вне её задайте свой пароль.
POSTGRES_DB=directory_service_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- nginx ---------------------------------------------------
# Порт на хосте, через который открывается приложение: http://localhost:<NGINX_PORT>
# Измените, если 80 занят (например, IIS или Skype).
NGINX_PORT=80

# --- Frontend ------------------------------------------------
# Базовый URL API для axios. Вшивается в JS во время `npm run build`,
# поэтому после изменения нужен `docker compose up -d --build`.
# "/" означает относительные запросы через nginx (location /api/ → backend).
NEXT_PUBLIC_API_URL=/
